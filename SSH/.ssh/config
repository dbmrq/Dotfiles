# SSH Configuration
#
# Machine-specific GitHub account configuration is in ~/.ssh/config.local
# This file is generated by the bootstrap script based on your accounts.
#
# To add/modify GitHub accounts, run the bootstrap script again or
# manually edit ~/.ssh/config.local

# --- Include machine-specific config ---
Include ~/.ssh/config.local

# --- General SSH settings ---
Host *
    AddKeysToAgent yes
    # UseKeychain is macOS-only; IgnoreUnknown prevents errors on Linux
    IgnoreUnknown UseKeychain
    UseKeychain yes

# --- Homelab (eq12) ---
# The key lives in Vaultwarden and is loaded into the ssh-agent by
# `vault ssh-load` (Bitwarden desktop agent first, `ssh-add` fallback); no
# private key is stored on disk. Password auth stays available as fallback.
Host eq12 eq12.local eq12.abacate.top
    HostName eq12.local
    User daniel
