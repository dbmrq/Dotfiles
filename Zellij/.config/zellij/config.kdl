// Zellij Configuration
// ====================

// Use terminal's ANSI colors (inherits from Ghostty theme)
theme "ansi"

// Cleaner UI without special font characters
simplified_ui true

// No borders around panes
pane_frames false

// Use compact layout (single bar at bottom with tabs)
default_layout "compact"

// Quit instead of detach when terminal closes
on_force_close "quit"

// Clipboard integration: use macOS pbcopy and auto-copy on selection
copy_command "pbcopy"       // send copied text to macOS clipboard
copy_clipboard "system"    // (default) explicit: use system clipboard
copy_on_select true         // auto-copy selection when mouse is released

show_startup_tips false

ui {
    pane_frames {
        hide_session_name true
    }
}

// ---------------------------------------------------------
// Keybindings: Using Zellij defaults (canonical reference)
// ---------------------------------------------------------
// We rely on Zellij's built-in modal bindings as the canonical
// window management system. macOS (Hammerspoon) and Neovim
// mirror these patterns for consistency:
//
// Ctrl+p  Pane mode    - hjkl focus, n new, x close, f fullscreen, w floating
// Ctrl+t  Tab mode     - hl switch, n new, x close, r rename
// Ctrl+n  Resize mode  - hjkl resize
// Ctrl+h  Move mode    - hjkl reposition pane
// Ctrl+s  Scroll mode  - scroll/search
// Ctrl+g  Locked mode  - passthrough to app
//
// j/k in Pane mode cycles through stacked panes.
// ---------------------------------------------------------

keybinds {
    // Only keep Shift+H/L for tab reordering (not a default)
    tab {
        bind "Shift Left" { MoveTab "Left"; }
        bind "Shift h" { MoveTab "Left"; }
        bind "Shift Right" { MoveTab "Right"; }
        bind "Shift l" { MoveTab "Right"; }
    }
}

