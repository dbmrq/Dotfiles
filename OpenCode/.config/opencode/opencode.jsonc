{
  "$schema": "https://opencode.ai/config.json",

  // Host-local agent skills (eq12 homelab tree). OpenCode auto-discovers
  // ~/.config/opencode/skills, ~/.claude/skills and ~/.agents/skills globally;
  // this adds the hub's host-specific skills. SKILL.md files are picked up at
  // any depth, so the category folders (media/, smart-home/, ...) are fine and
  // machines without the homelab checkout simply find nothing here.
  "skills": [
    "/mnt/data/protected/admin/homelab/skills"
  ],

  // youtube + firecrawl are only usable by the `research` subagent.
  // The top-level deny below hides their tools from every other agent;
  // agents/research.md re-allows them for itself. `codemode: false` keeps
  // them on each agent's native tool list instead of a shared Code Mode
  // catalog, so other agents never even see their descriptions.
  "mcp": {
    "servers": {
      "youtube": {
        "type": "local",
        "command": ["npx", "-y", "@anaisbetts/mcp-youtube"],
        "codemode": false
      },
      "firecrawl": {
        "type": "local",
        "command": ["npx", "-y", "firecrawl-mcp"],
        "codemode": false,
        "environment": {
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
        }
      }
    }
  },
  "permissions": [
    { "action": "youtube_*", "resource": "*", "effect": "deny" },
    { "action": "firecrawl_*", "resource": "*", "effect": "deny" }
  ]
}
