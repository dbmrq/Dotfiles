# Vim
Vim/.vim/bundle
Vim/.vim/undo/*
.netrwhist

# Bootstrap state
Bootstrap/.bootstrap_state

# Machine-specific configs (generated by bootstrap)
*.local
.gitconfig.local
SSH/.ssh/config.local

# SSH keys, agent sockets, and known hosts (should never be committed)
*.pub
id_*
*.pem
SSH/.ssh/known_hosts*
SSH/.ssh/agent/

# Backup/swap files
*.swp
*.un~
*~

# Auth/credential files (keep in password manager/auth store, not here)
**/auth.json
credentials.json
*.p8
*.p12
*.cer
*.crt
*.csr
*.key

# GitHub CLI (contains auth tokens and user preferences)
Vim/.config/gh/

# uv (Python package manager - machine-specific)
Vim/.config/uv/
Vim/.config/fish/

# macOS
.DS_Store

# Hammerspoon Spoons (managed by SpoonInstall)
Hammerspoon/.hammerspoon/Spoons/

# Agent skills mirrors. The canonical personal/external/Xcode skills now live
# in the dbmrq/agent-skills repo and are installed by its scripts/install-all.sh
# into real dirs outside this repo (~/.agents/skills, ~/.config/opencode/skills,
# ~/.claude/skills, ...). Never track mirrors or project-local installs here.
# (Anchored to the repo root: on case-insensitive filesystems an unanchored
# "Agents/" also matched OpenCode/.config/opencode/agents/.)
/Agents/
/.agents/
/.augment/
/.cursor/
/.claude/
/.copilot/

# OpenCode package: skills and node_modules are generated/installed at runtime
# (skill mirrors + plugin dependency install tree), not user-authored config.
OpenCode/.config/opencode/skills/
OpenCode/.config/opencode/node_modules/
OpenCode/.config/opencode/.gitignore

# Zed runtime data: created by the editor inside .config/zed (database, prompts
# index, themes store). Defensive coverage in case a machine still folds the
# directory into this repo; these must never be committed.
Zed/.config/zed/db/
Zed/.config/zed/prompts/
Zed/.config/zed/themes/
Zed/.config/zed/logs/

# Runtime/cache data that must never be committed
.cache/
*.log
