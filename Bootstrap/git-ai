#!/usr/bin/env bash
# AI-assisted commit message generation using GitHub Copilot
# Usage: git ai [--all|-a] [--dry-run|-n]
#   --all/-a:    Stage all changes before committing
#   --dry-run/-n: Show the generated message without committing

set -euo pipefail

# Find cheapest available copilot model
_copilot_cheap_model() {
    local models
    models=$(copilot --help 2>&1 | grep -oE '"[^"]+"' | tr -d '"' | sort -t'-' -k2 -rV)

    # Fallback chain: codex-mini > gpt-mini > haiku
    for pattern in 'codex-mini$' 'gpt-[0-9.]+-mini$' '^claude-haiku'; do
        local match
        match=$(echo "$models" | grep -E "$pattern" | head -1)
        if [[ -n "$match" ]]; then
            echo "$match"
            return 0
        fi
    done

    # Ultimate fallback: first model in list
    echo "$models" | head -1
}

stage_all=false
dry_run=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--all) stage_all=true; shift ;;
        -n|--dry-run) dry_run=true; shift ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# Stage all if requested
if $stage_all; then
    git add -A
fi

# Check for staged changes
if ! git diff --cached --quiet 2>/dev/null; then
    diff_output=$(git diff --cached)
elif ! git diff --quiet 2>/dev/null; then
    echo "No staged changes. Stage changes first or use -a to stage all." >&2
    exit 1
else
    echo "No changes to commit." >&2
    exit 1
fi

# Find cheapest model
echo "Finding model..." >&2
model=$(_copilot_cheap_model)

# Generate commit message using copilot
echo "Generating commit message with $model..." >&2
prompt="Generate a git commit message for these changes.

Rules:
- Use conventional commits format: type(scope): description
- First line: concise summary (max 72 chars)
- Add blank line then bullet points for significant changes
- Be specific about what changed and why
- Output ONLY the commit message, no explanations"
message=$(echo "$diff_output" | copilot -sp "$prompt" --model "$model" 2>/dev/null)

if [[ -z "$message" ]]; then
    echo "Failed to generate commit message." >&2
    exit 1
fi

# Clean up: remove wrapping quotes/backticks, trim leading/trailing whitespace
message=$(echo "$message" | sed 's/^```[a-z]*//;s/```$//' | sed 's/^["`'"'"']*//;s/["`'"'"']*$//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if $dry_run; then
    echo "Generated message:"
    echo "$message"
    exit 0
fi

echo "Committing with message:"
echo "$message"
echo ""
git commit -m "$message"
