{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "abacate": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Abacate",
      "options": {
        "baseURL": "https://llm.abacate.top/v1"
      },
      "models": {
        "cost": { "name": "Cost" },
        "balance": { "name": "Balance" },
        "performance": { "name": "Performance" }
      }
    }
  },
  "model": "abacate/cost",
  "agent": {
    "build": { "model": "abacate/cost" },
    "general": { "model": "abacate/cost" },
    "explore": { "model": "abacate/cost" }
  },
  "permission": "allow",
  "subagent_depth": 1,
  "plugin": [
    "./plugin/caffeinate.ts",
    [
      "./plugin/orchestration/orchestration-context.ts",
      {
        "context": {
          "maxContextCharacters": 2000,
          "scopeDepth": 16,
          "retentionMaxRecords": 50,
          "retentionMaxAgeDays": 30
        }
      }
    ]
  ]
}
