# Machine-specific zsh configuration
# Copy this file to ~/.zshrc.local and customize as needed
#
# This file is sourced at the end of .zshrc and is for settings
# that vary per machine (tool-specific paths, aliases, etc.)
#
# Credentials live in the Vaultwarden store: run `vault unlock` and the
# variables listed in Bootstrap/vault-env.conf are exported automatically.
# Do not hardcode secrets here.

# Example: uv (Python package manager)
# [[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Example: nvm (Node Version Manager)
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Example: rbenv (Ruby version manager)
# eval "$(rbenv init - zsh)"

# Example: Work-specific aliases
# alias vpn='networksetup -connectpppoeservice "Work VPN"'

# Example: non-vault API keys (prefer `vault put MY_ITEM` + vault-env.conf)
# export SOME_API_KEY="..."

