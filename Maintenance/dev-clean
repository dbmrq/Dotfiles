#!/usr/bin/env python3
"""dev-clean — reclaim space from regenerable developer artifacts.

Everything this tool deletes is either a cache or can be regenerated by
Xcode/SwiftPM/the package manager. It never touches source, archives, exported
IPAs, or user data.

Groups:
  simulators       Old simulator runtimes, their devices, and orphaned devices
  device-support   Old iOS DeviceSupport symbol folders
  xcode-derived    Xcode DerivedData unused for N days
  ralph            .ralph-loop/DerivedData and app build/ intermediates
  swift-build      SwiftPM .build directories under the projects folder
  caches           Homebrew/npm/uv/Periphery/CoreDevice caches

The launchd job runs the Library-only groups (simulators, device-support,
xcode-derived, caches). The workspace groups live under ~/Documents, which
macOS TCC blocks for launchd jobs; run those from a terminal.

Usage:
  dev-clean --dry-run                      # show what would be deleted
  dev-clean                                # delete with default retention
  dev-clean --only simulators --dry-run
  dev-clean --only caches
  dev-clean --derived-days 14 --ralph-days 7
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
PROJECTS = HOME / "Documents" / "Programação"
LEIO_WORKSPACE = PROJECTS / "iOS" / "LeioApps"
XCODE_DERIVED = HOME / "Library/Developer/Xcode/DerivedData"
DEVICE_SUPPORT = HOME / "Library/Developer/Xcode/iOS DeviceSupport"
SIMULATOR_DEVICES = HOME / "Library/Developer/CoreSimulator/Devices"
LOCK_FILE = HOME / ".cache/dev-clean.lock"

GROUPS = (
    "simulators",
    "device-support",
    "xcode-derived",
    "ralph",
    "swift-build",
    "caches",
)
DEFAULT_GROUPS = ("simulators", "device-support", "xcode-derived", "ralph", "swift-build")

DRY_RUN = False
FORCE = False


def human(size: int) -> str:
    value = float(size)
    for unit in ("B", "K", "M", "G", "T"):
        if value < 1024 or unit == "T":
            return f"{value:.1f}{unit}"
        value /= 1024
    return f"{value:.1f}T"


def log(message: str) -> None:
    print(f"[dev-clean] {message}", flush=True)


def run(cmd: list[str], timeout: int = 120) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return None


def du_bytes(path: Path) -> int:
    result = run(["du", "-sk", str(path)], timeout=300)
    if result and result.returncode == 0:
        try:
            return int(result.stdout.split()[0]) * 1024
        except (ValueError, IndexError):
            return 0
    return 0


def newest_mtime(path: Path) -> float:
    """Newest mtime of any file or directory below path (0 when unreadable)."""
    newest = 0.0
    try:
        newest = os.stat(path, follow_symlinks=False).st_mtime
        for root, dirs, files in os.walk(path):
            for name in dirs + files:
                try:
                    stat = os.stat(os.path.join(root, name), follow_symlinks=False)
                except OSError:
                    continue
                if stat.st_mtime > newest:
                    newest = stat.st_mtime
    except OSError:
        return 0.0
    return newest


def is_stale(path: Path, days: int) -> bool:
    newest = newest_mtime(path)
    return newest > 0 and (time.time() - newest) > days * 86400


def process_running(name: str) -> bool:
    result = run(["pgrep", "-x", name], timeout=10)
    return bool(result and result.returncode == 0)


def repo_root(path: Path) -> Path | None:
    result = run(["git", "-C", str(path), "rev-parse", "--show-toplevel"], timeout=10)
    if result and result.returncode == 0:
        return Path(result.stdout.strip())
    return None


def has_tracked_files(path: Path) -> bool:
    """True when deleting this directory would remove files tracked by Git."""
    root = repo_root(path)
    if root is None:
        return False
    # macOS stores paths in decomposed Unicode; git echoes that form while
    # Path.home() may give the precomposed form. Normalize before comparing.
    root = Path(unicodedata.normalize("NFC", str(root)))
    path = Path(unicodedata.normalize("NFC", str(path)))
    try:
        relative = path.relative_to(root)
    except ValueError:
        return False
    result = run(["git", "-C", str(root), "ls-files", "--", str(relative)], timeout=30)
    return bool(result and result.stdout.strip())


def lock() -> object | None:
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    handle = LOCK_FILE.open("w")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        log("another dev-clean run is already active; exiting")
        return None
    return handle


def delete(path: Path, label: str | None = None, total: list[int] | None = None) -> int:
    label = label or str(path)
    if not path.exists() and not path.is_symlink():
        return 0
    size = du_bytes(path)
    if DRY_RUN:
        log(f"  would delete {label} ({human(size)})")
    else:
        try:
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            else:
                path.unlink()
            log(f"  deleted {label} ({human(size)})")
        except OSError as error:
            log(f"  ERROR deleting {label}: {error}")
            return 0
    if total is not None:
        total[0] += size
    return size


def prune_versions(
    versions: Path, current: Path | None, label: str, total: list[int]
) -> None:
    """Delete version dirs/files other than the one the current symlink uses."""
    if not versions.is_dir() or current is None or not current.exists():
        return
    current = current.resolve()
    for entry in versions.iterdir():
        if entry.resolve() == current:
            continue
        delete(entry, f"{label} old version {entry.name}", total)


# --- Simulators -------------------------------------------------------------


def parse_version(value: str) -> tuple[int, ...]:
    parts = tuple(int(part) for part in re.findall(r"\d+", value))
    return parts or (0,)


def build_rank(build: str) -> tuple[int, int, int]:
    """Rank Xcode builds for the same OS version; release beats beta."""
    numbers = [int(part) for part in re.findall(r"\d+", build)]
    major = numbers[0] if numbers else 0
    minor = numbers[1] if len(numbers) > 1 else 0
    # A trailing lowercase letter (e.g. 24A5370g) marks a beta build.
    beta = 1 if re.search(r"\d[a-z]$", build) else 0
    return (-beta, major, minor)


def simulator_runtimes() -> list[dict]:
    result = run(["xcrun", "simctl", "runtime", "list", "-j"], timeout=120)
    if not result or result.returncode != 0:
        log("  WARNING: could not list simulator runtimes")
        return []
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        log("  WARNING: could not parse simulator runtime list")
        return []
    runtimes = []
    for identifier, item in data.items():
        if not item.get("deletable"):
            continue
        version = item.get("version", "")
        runtimes.append(
            {
                "id": identifier,
                "version": version,
                "major_minor": parse_version(version)[:2],
                "build": item.get("build", ""),
                "last_used": item.get("lastUsedAt", ""),
                "runtime_identifier": item.get("runtimeIdentifier", ""),
                "parent": item.get("parentMountPath", ""),
                "size": int(item.get("sizeBytes", 0)),
            }
        )
    return runtimes


def simulator_devices() -> list[dict]:
    result = run(["xcrun", "simctl", "list", "devices", "--json"], timeout=120)
    if not result or result.returncode != 0:
        return []
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return []
    devices = []
    for runtime, items in data.get("devices", {}).items():
        for item in items:
            devices.append(
                {
                    "udid": item.get("udid", ""),
                    "name": item.get("name", ""),
                    "state": item.get("state", ""),
                    "runtime": runtime,
                    "size": int(item.get("dataPathSize", 0) or 0),
                    "available": bool(item.get("isAvailable", False)),
                }
            )
    return devices


def group_simulators(args: argparse.Namespace, total: list[int]) -> None:
    log("simulators")
    runtimes = simulator_runtimes()
    devices = simulator_devices()

    if not runtimes:
        return

    versions = sorted(
        {runtime["major_minor"] for runtime in runtimes}, reverse=True
    )
    keep_versions = set(versions[: args.keep_simulator_versions])
    runtime_delete: list[dict] = []
    for version in versions:
        group = [runtime for runtime in runtimes if runtime["major_minor"] == version]
        group.sort(
            key=lambda runtime: (
                build_rank(runtime["build"]),
                runtime["last_used"] or "",
            ),
            reverse=True,
        )
        if version not in keep_versions:
            runtime_delete.extend(group)
        else:
            runtime_delete.extend(group[1:])

    if not runtime_delete:
        log("  no runtimes to prune")
    else:
        booted = {
            device["runtime"]
            for device in devices
            if device["state"] == "Booted"
        }
        blocked = {runtime["runtime_identifier"] for runtime in runtime_delete} & booted
        if blocked and not FORCE:
            log(
                "  skipping runtime(s) used by a booted simulator: "
                + ", ".join(sorted(blocked))
                + " (use --force to override)"
            )
            runtime_delete = [
                runtime
                for runtime in runtime_delete
                if runtime["runtime_identifier"] not in blocked
            ]

        removed_runtime_ids: set[str] = set()
        for runtime in runtime_delete:
            label = f"{runtime['version']} ({runtime['build']})"
            if DRY_RUN:
                log(f"  would delete runtime {label} ({human(runtime['size'])})")
                total[0] += runtime["size"]
                removed_runtime_ids.add(runtime["runtime_identifier"])
            else:
                result = run(
                    ["xcrun", "simctl", "runtime", "delete", runtime["id"]],
                    timeout=600,
                )
                if result and result.returncode == 0:
                    log(f"  deleted runtime {label} ({human(runtime['size'])})")
                    total[0] += runtime["size"]
                    removed_runtime_ids.add(runtime["runtime_identifier"])
                else:
                    detail = (result.stderr or result.stdout).strip() if result else ""
                    log(f"  ERROR deleting runtime {label}: {detail}")

        # The devices that lived on a fully removed runtime are freed with it.
        delete_ids = {runtime["id"] for runtime in runtime_delete}
        kept_runtime_ids = {
            runtime["runtime_identifier"]
            for runtime in runtimes
            if runtime["id"] not in delete_ids
        }
        fully_removed = {runtime["runtime_identifier"] for runtime in runtime_delete} - kept_runtime_ids
        for device in devices:
            if device["runtime"] in fully_removed:
                total[0] += device["size"]

    # Devices whose runtime is gone (or marked unavailable) are now collapsible.
    if not DRY_RUN:
        result = run(["xcrun", "simctl", "delete", "unavailable"], timeout=300)
        if result and result.returncode != 0:
            log(f"  WARNING: could not delete unavailable devices: {result.stderr.strip()}")

    # Device directories with no device.plist are leftovers from interrupted
    # deletes and are invisible to simctl.
    if SIMULATOR_DEVICES.is_dir():
        for entry in SIMULATOR_DEVICES.iterdir():
            if entry.is_dir() and not (entry / "device.plist").exists():
                delete(entry, f"orphaned simulator device {entry.name}", total)

    # simctl sometimes removes a runtime but leaves its MobileAsset behind
    # (usually because the asset is still registered with the system). Those
    # are owned by root, so report the exact sudo command instead of failing.
    assets = Path("/System/Library/AssetsV2/com_apple_MobileAsset_iOSSimulatorRuntime")
    if assets.is_dir():
        remaining = simulator_runtimes()
        parents = [runtime["parent"] for runtime in remaining if runtime["parent"]]
        for asset in assets.glob("*.asset"):
            if any(str(asset) in parent for parent in parents):
                continue
            size = du_bytes(asset)
            log(
                f"  WARNING: unreferenced simulator asset {asset.name} "
                f"({human(size)}); remove with: sudo rm -rf '{asset}'"
            )


def simulator_version_key(name: str) -> tuple[int, ...]:
    """OS version from a DeviceSupport folder name, e.g. 'iPhone18,3 26.6.2 (23G90)'."""
    match = re.search(r"(\d+)\.(\d+)(?:\.(\d+))?", name)
    if not match:
        return (0,)
    return tuple(int(part) for part in match.groups() if part is not None)


def group_device_support(args: argparse.Namespace, total: list[int]) -> None:
    log("device-support")
    if not DEVICE_SUPPORT.is_dir():
        log("  nothing to do")
        return
    entries = [entry for entry in DEVICE_SUPPORT.iterdir() if entry.is_dir()]
    entries.sort(
        key=lambda entry: (simulator_version_key(entry.name), newest_mtime(entry)),
        reverse=True,
    )
    for entry in entries[args.keep_device_support :]:
        delete(entry, f"DeviceSupport {entry.name}", total)


# --- Build artifacts --------------------------------------------------------


def derived_workspace_path(entry: Path) -> str:
    info = entry / "info.plist"
    if not info.is_file():
        return ""
    try:
        import plistlib

        with info.open("rb") as handle:
            data = plistlib.load(handle)
        return str(data.get("WorkspacePath", ""))
    except (OSError, ValueError):
        return ""


def group_xcode_derived(args: argparse.Namespace, total: list[int]) -> None:
    log("xcode-derived")
    if not XCODE_DERIVED.is_dir():
        log("  nothing to do")
        return
    busy = not FORCE and (
        process_running("xcodebuild") or process_running("XCBBuildService")
    )
    if busy:
        log("  a build is running; only removing orphaned DerivedData")

    for entry in XCODE_DERIVED.iterdir():
        workspace = derived_workspace_path(entry)
        if workspace and not Path(workspace).exists():
            delete(entry, f"DerivedData {entry.name} (workspace no longer exists)", total)
            continue
        if busy:
            continue
        if is_stale(entry, args.derived_days):
            delete(entry, f"DerivedData {entry.name}", total)


def loop_is_running(workspace: Path) -> bool:
    pid_file = workspace / ".ralph-loop" / "loop.pid"
    try:
        pid = int(pid_file.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def is_release_artifact(path: Path) -> bool:
    return path.suffix == ".xcarchive" or path.name == "export"


def group_ralph(args: argparse.Namespace, total: list[int]) -> None:
    log("ralph")
    workspaces = []
    for root, dirs, _files in os.walk(PROJECTS):
        if ".ralph-loop" in dirs:
            workspaces.append(Path(root))
            dirs.remove(".ralph-loop")
        if ".git" in dirs:
            dirs.remove(".git")
        if "Library" in dirs:
            dirs.remove("Library")

    if not workspaces:
        log("  no .ralph-loop directories found")
    for workspace in workspaces:
        if loop_is_running(workspace):
            log(f"  {workspace}: loop is running; skipping")
            continue
        derived = workspace / ".ralph-loop" / "DerivedData"
        if derived.is_dir():
            for entry in derived.iterdir():
                if is_stale(entry, args.ralph_days):
                    delete(entry, f"{workspace.name} .ralph-loop/DerivedData/{entry.name}", total)

    # App build/ folders: keep archives and exported IPAs, delete the rest.
    if LEIO_WORKSPACE.is_dir():
        for app in sorted(LEIO_WORKSPACE.iterdir()):
            build = app / "build"
            if not build.is_dir():
                continue
            for entry in build.iterdir():
                if is_release_artifact(entry):
                    continue
                if has_tracked_files(entry):
                    log(f"  keeping {app.name}/build/{entry.name} (contains tracked files)")
                    continue
                if is_stale(entry, args.build_days):
                    delete(entry, f"{app.name}/build/{entry.name}", total)


def group_swift_build(args: argparse.Namespace, total: list[int]) -> None:
    log("swift-build")
    if not PROJECTS.is_dir():
        log("  nothing to do")
        return
    for root, dirs, _files in os.walk(PROJECTS):
        if ".git" in dirs:
            dirs.remove(".git")
        if "Library" in dirs:
            dirs.remove("Library")
        if ".build" not in dirs:
            continue
        build = Path(root) / ".build"
        dirs.remove(".build")
        if has_tracked_files(build):
            log(f"  keeping {build.relative_to(PROJECTS)} (contains tracked files)")
            continue
        if is_stale(build, args.swift_build_days):
            delete(build, f"{build.relative_to(PROJECTS)}", total)


# --- Caches -----------------------------------------------------------------


def group_caches(args: argparse.Namespace, total: list[int]) -> None:
    log("caches")
    xcode_busy = (
        process_running("xcodebuild")
        or process_running("XCBBuildService")
        or process_running("swift")
    )

    # Chrome is deliberately excluded: clearing its cache can drop open tabs and
    # profiles. Use Chrome's own settings when you want to clear it.
    brew = shutil.which("brew")
    if brew and not process_running("brew"):
        if DRY_RUN:
            log("  would run brew cleanup --prune=all")
        else:
            result = run([brew, "cleanup", "--prune=all"], timeout=900)
            if result and result.returncode == 0:
                log("  ran brew cleanup")
            else:
                detail = (result.stderr or result.stdout).strip() if result else ""
                log(f"  WARNING: brew cleanup failed: {detail}")

    npm = shutil.which("npm")
    if npm and not process_running("npm"):
        if DRY_RUN:
            log("  would run npm cache verify")
        else:
            result = run([npm, "cache", "verify"], timeout=300)
            if result and result.returncode == 0:
                log("  ran npm cache verify")
            else:
                detail = (result.stderr or result.stdout).strip() if result else ""
                log(f"  WARNING: npm cache verify failed: {detail}")

    uv = shutil.which("uv")
    if uv and not process_running("uv"):
        if DRY_RUN:
            log("  would run uv cache prune")
        else:
            result = run([uv, "cache", "prune"], timeout=300)
            if result and result.returncode == 0:
                log("  ran uv cache prune")
            else:
                detail = (result.stderr or result.stdout).strip() if result else ""
                log(f"  WARNING: uv cache prune failed: {detail}")

    if not process_running("periphery"):
        periphery = HOME / "Library/Caches/com.github.peripheryapp"
        if periphery.exists() and is_stale(periphery, args.cache_days):
            delete(periphery, "Periphery DerivedData", total)

    core_device = (
        HOME
        / "Library/Containers/com.apple.CoreDevice.CoreDeviceService/Data/Library/Caches/AppInstallationBinaryDeltas"
    )
    if core_device.exists() and is_stale(core_device, args.cache_days):
        delete(core_device, "CoreDevice app installation deltas", total)

    if not xcode_busy:
        for path, label in (
            (HOME / "Library/Caches/org.swift.swiftpm/artifacts", "SwiftPM artifact cache"),
            (HOME / "Library/Caches/org.swift.swiftpm/repositories", "SwiftPM repository cache"),
        ):
            if path.exists() and is_stale(path, args.cache_days):
                delete(path, label, total)

    # Album artwork and map tiles are intentionally not automated: deleting them
    # only makes macOS re-download the same data. Clear them by hand if needed.

    # Superseded CLI versions: keep only what the current symlink points at.
    cursor_link = HOME / ".local/bin/cursor-agent"
    if cursor_link.is_symlink():
        prune_versions(
            HOME / ".local/share/cursor-agent/versions",
            cursor_link.resolve().parent,
            "cursor-agent",
            total,
        )
    claude_link = HOME / ".local/bin/claude"
    if claude_link.is_symlink():
        prune_versions(
            HOME / ".local/share/claude/versions",
            claude_link.resolve(),
            "Claude",
            total,
        )
    codex_current = HOME / ".codex/packages/standalone/current"
    if codex_current.is_symlink():
        prune_versions(
            HOME / ".codex/packages/standalone/releases",
            codex_current.resolve(),
            "Codex",
            total,
        )
    for old in (HOME / ".local/bin").glob("agy.*.old"):
        delete(old, f"old agy binary {old.name}", total)


GROUP_HANDLERS = {
    "simulators": group_simulators,
    "device-support": group_device_support,
    "xcode-derived": group_xcode_derived,
    "ralph": group_ralph,
    "swift-build": group_swift_build,
    "caches": group_caches,
}


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Reclaim space from regenerable developer artifacts."
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="show what would be deleted without deleting anything",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="delete while Xcode/xcodebuild or a booted simulator is running",
    )
    parser.add_argument(
        "--only",
        default=",".join(DEFAULT_GROUPS),
        help=f"comma-separated groups (default: {','.join(DEFAULT_GROUPS)})",
    )
    parser.add_argument(
        "--keep-simulator-versions",
        type=int,
        default=2,
        help="number of newest iOS minor versions to keep (default: 2)",
    )
    parser.add_argument(
        "--keep-device-support",
        type=int,
        default=2,
        help="number of newest DeviceSupport folders to keep (default: 2)",
    )
    parser.add_argument(
        "--derived-days",
        type=int,
        default=30,
        help="unused days before Xcode DerivedData is removed (default: 30)",
    )
    parser.add_argument(
        "--ralph-days",
        type=int,
        default=14,
        help="unused days before .ralph-loop DerivedData is removed (default: 14)",
    )
    parser.add_argument(
        "--build-days",
        type=int,
        default=14,
        help="unused days before app build/ intermediates are removed (default: 14)",
    )
    parser.add_argument(
        "--swift-build-days",
        type=int,
        default=30,
        help="unused days before SwiftPM .build folders are removed (default: 30)",
    )
    parser.add_argument(
        "--cache-days",
        type=int,
        default=30,
        help="unused days before aged caches (Periphery, SwiftPM, CoreDevice) are removed (default: 30)",
    )
    args = parser.parse_args()

    global DRY_RUN, FORCE
    DRY_RUN = args.dry_run
    FORCE = args.force

    selected = [group.strip() for group in args.only.split(",") if group.strip()]
    unknown = [group for group in selected if group not in GROUP_HANDLERS]
    if unknown:
        parser.error(f"unknown group(s): {', '.join(unknown)}")

    handle = lock()
    if handle is None:
        return 1

    started = time.time()
    total = [0]
    log(
        "dry run" if DRY_RUN else "deleting",
    )
    log(f"groups: {', '.join(selected)}")
    for group in selected:
        GROUP_HANDLERS[group](args, total)

    elapsed = time.time() - started
    log(f"reclaimed {human(total[0])} in {elapsed:.1f}s")
    if DRY_RUN:
        log("nothing was deleted (dry run)")
    handle.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
